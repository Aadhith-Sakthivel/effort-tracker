{
  "name": "effort-tracker",
  "version": "1.0.0",
  "description": "Team effort & timesheet tracker. Runs locally on embedded Postgres (PGlite) and on Databricks Apps with Lakebase.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/",
    "reset": "node -e \"require('fs').rmSync('.data',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.2.17",
    "express": "4.21.2",
    "pg": "8.13.1"
  }
}
